{
  "manifest_version": 2,
  "id": "WMX20081122.maibot-qiandao",
  "version": "1.0.0",
  "name": "签到卡片",
  "description": "发送「签到」生成精美签到卡片，支持一言、累计/连续签到统计与排行榜。MaiBot 移植版，迁移来源：WMX20081122/astrbot_plugin_qiandao。",
  "author": {
    "name": "WMX20081122",
    "url": "https://github.com/WMX20081122"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/WMX20081122/maibot-qiandao",
    "homepage": "https://github.com/WMX20081122/maibot-qiandao",
    "documentation": "https://github.com/WMX20081122/maibot-qiandao/blob/main/README.md",
    "issues": "https://github.com/WMX20081122/maibot-qiandao/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "capabilities": [
    "api.call",
    "send.image",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🗓️",
      "background": "#f2a33c"
    }
  }
}
